<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:homeVm="using:TaleLoom.ViewModels.Home"
             xmlns:homeViews="using:TaleLoom.Views.Home"
             xmlns:prefabVm="using:TaleLoom.ViewModels.Prefabs"
             xmlns:prefabViews="using:TaleLoom.Views.Prefabs"
             xmlns:imageVm="using:TaleLoom.ViewModels.Images"
             xmlns:imageViews="using:TaleLoom.Views.Images"
             xmlns:entityVm="using:TaleLoom.ViewModels.Entities"
             xmlns:entityViews="using:TaleLoom.Views.Entities"
             xmlns:entityFields="using:TaleLoom.Views.Entities.Fields"
             x:Class="TaleLoom.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        
        <DataTemplate DataType="{x:Type homeVm:HomeViewModel}">
            <homeViews:HomeView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type prefabVm:PrefabListViewModel}">
            <prefabViews:PrefabListView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type prefabVm:PrefabEditorViewModel}">
            <prefabViews:PrefabEditorView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type entityVm:EntitiesListViewModel}">
            <entityViews:EntitiesListView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type entityVm:EntityEditorViewModel}">
            <entityViews:EntityEditorView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type imageVm:ImageGalleryViewModel}">
            <imageViews:ImageGalleryView />
        </DataTemplate>
        
    </Application.DataTemplates>
             
    <Application.Resources>
        <DataTemplate x:Key="IntegerFieldTemplate">
            <entityFields:IntegerFieldEditor />
        </DataTemplate>
        
        <DataTemplate x:Key="FloatFieldTemplate">
            <entityFields:FloatFieldEditor />
        </DataTemplate>
        
        <DataTemplate x:Key="NameFieldTemplate">
            <entityFields:NameFieldEditor />
        </DataTemplate>
        
        <DataTemplate x:Key="TextFieldTemplate">
            <entityFields:TextFieldEditor />
        </DataTemplate>
        
        <DataTemplate x:Key="ImageFieldTemplate">
            <entityFields:ImageFieldEditor />
        </DataTemplate>
        
        <DataTemplate x:Key="UrlFieldTemplate">
            <entityFields:UrlFieldEditor />
        </DataTemplate>
        
        <DataTemplate x:Key="ReferenceFieldTemplate">
            <entityFields:ReferenceFieldEditor />
        </DataTemplate>
        
        <entityVm:EntityFieldTemplateSelector
            x:Key="EntityFieldTemplateSelector"
            IntegerTemplate="{StaticResource IntegerFieldTemplate}"
            FloatTemplate="{StaticResource FloatFieldTemplate}"
            NameTemplate="{StaticResource NameFieldTemplate}"
            TextTemplate="{StaticResource TextFieldTemplate}"
            ImageTemplate="{StaticResource  ImageFieldTemplate}"
            UrlTemplate="{StaticResource UrlFieldTemplate}" 
            ReferenceTemplate="{StaticResource ReferenceFieldTemplate}" 
            />
        
        
    </Application.Resources>
             
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>