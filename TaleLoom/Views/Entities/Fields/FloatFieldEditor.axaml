<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaleLoom.ViewModels.Entities"
             x:Class="TaleLoom.Views.Entities.Fields.FloatFieldEditor"
             x:DataType="vm:EntityFieldEditorViewModel"
>
    
    <StackPanel Spacing="4">
        
        <TextBlock Text="{Binding Field.Name, Mode=OneWay}" />
        
        <NumericUpDown
            Value="{Binding ValueAsDouble, Mode=TwoWay}"
            ParsingNumberStyle="Float"
            FormatString="0.0"
        />
        
    </StackPanel>
</UserControl>
