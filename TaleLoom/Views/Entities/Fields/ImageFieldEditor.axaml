<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaleLoom.ViewModels.Entities.Fields"
             x:Class="TaleLoom.Views.Entities.Fields.ImageFieldEditor"
             x:DataType="vm:ImageFieldEditorViewModel"
            >
    
    <StackPanel Spacing="4">
        
        <TextBlock Text="{Binding Field.Name, Mode=OneWay}" />
        
        <Button
            Content="Select Image"
            Command="{Binding SelectImageCommand}"
            HorizontalAlignment="Left"
            Margin="10" />
        
        <Button>
            <Image
                Source="{Binding  ValueAsImage}" 
                MaxHeight="200"
                Stretch="Uniform"
            />
        </Button>
        
        <TextBlock Text="{Binding Field.Type}" />
        
    </StackPanel>
</UserControl>
