<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaleLoom.ViewModels.Entities"
             x:Class="TaleLoom.Views.Entities.Fields.TextFieldEditor"
             x:DataType="vm:EntityFieldEditorViewModel"
>
    
    <StackPanel Spacing="4">
        
        <TextBlock Text="{Binding Field.Name}" />
        
        <TextBox
            Height="100"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            Text="{Binding Value, Mode=TwoWay}"/>
        
    </StackPanel>
</UserControl>
