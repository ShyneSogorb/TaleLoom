<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaleLoom.ViewModels.Entities"
             x:Class="TaleLoom.Views.Entities.EntityEditorView"
             x:DataType="vm:EntityEditorViewModel">
    
    <Grid 
        RowDefinitions="Auto, Auto, *, Auto, Auto"
        Margin="20, 10">
        
        <!-- Current location -->
        
        <TextBlock Grid.Row="0" Text="Manage Entity" />
        
        <!-- Entity name -->
        
        <TextBox Grid.Row="1" Text="{Binding Name, Mode=TwoWay}" />
        
        <!-- Prefab fields -->
        
        <ScrollViewer
            Grid.Row="2"
            Margin="0, 10">
            
        <ItemsControl 
            ItemsSource="{Binding Fields}" 
            ItemTemplate="{StaticResource EntityFieldTemplateSelector}"
            Margin="25, 5">

        </ItemsControl>
            
        </ScrollViewer> 
        
        <!-- Save -->
        
        <Button 
            Grid.Row="3"
            Command="{Binding SaveEntityCommand}"
            Content="Save entity"></Button>
        
        <!-- Delete -->
        
    </Grid>
    
</UserControl>
