<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaleLoom.ViewModels.Home"
             x:Class="TaleLoom.Views.Home.HomeView"
             x:DataType="vm:HomeViewModel">
    
    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="20">
        
        <TextBlock
            Text="Welcome to TaleLoom"
            FontSize="28"
            HorizontalAlignment="Center" />
        
        <TextBlock
            Text="Create and manage your worlds, characters and stories"
            HorizontalAlignment="Center" />
        
    </StackPanel>
    
</UserControl>
